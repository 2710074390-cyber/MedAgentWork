# ── MedAgentWork .gitignore（合并：工具链 + 网页部署，2026-08-20）──

# ── Python / 工具链 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试覆盖率与安全扫描产物（本地运行 CI 同款命令时生成，可重建）
.coverage
coverage.xml
bandit-report.json

# 原子写入临时文件
*.tmp

# 生成报告（可重建，铁律②：reports/ 按保留策略管理）
reports/

# RAG 索引与分块元数据（可重建）
知识库素材/index_store/
知识库素材/chunks_metadata/

# CMExam 锚点体系原始数据（可重建，~174MB 含 npz，2026-08-21）
知识库素材/cmexam/

# RAG 检索日志与缓存（可重建，2026-08-30 补漏）
知识库素材/retrieval_log/
知识库素材/cache/

# registry 写前自动备份（安全快照，不入库；git 历史即最终备份）
question_bank/registry_backup_*.jsonl

# 真题题目级索引（可由 GoldenSet + 本地 CMExam 重建；CMExam 本身不入库，2026-10-20）
question_bank/real_questions/

# 执业医师历年真题 OCR/MinerU 语料（可由原 PDF 重建；原 PDF 与缓存均不入库，2026-10-22）
知识库素材/执业医师真题/

# 本地快捷方式（指向外部路径，仅本机有效）
*.lnk

# 临时目录（铁律：_scratch/temp 一周内清理）
temp/
tmp/
_scratch/

# GoldenSet 回归报告（可重建，2026-08-30 补漏）
GoldenSet/regression_reports/

# 历史归档（稳定内容，不入库保持仓库精简）
archive/

# 大体积输入素材（PDF/DOCX 二进制，保持仓库为纯文本）
输入素材/**/*.pdf
输入素材/**/*.docx
知识库素材/**/*.pdf
知识库素材/**/*.docx

# 教材 MinerU 解析产物（可由 PDF 重建；含教材插图，体量大且涉版权，仅本机个人复习使用）
# 见 scripts/kb_finalize_textbook_mineru.py 与 scripts/kb_build_textbook_index.py
知识库素材/**/_mineru_raw/
知识库素材/**/*_mineru/

# Obsidian 导出产物（2026-09-21）：分册 md 入库（纯文本），
# 但插图体量大且涉版权、原始整册可由 MinerU 产物重建，二者不入库
Obsidian产物/**/images/
Obsidian产物/_source/

# ── 网页部署（Cloudflare Pages / wrangler）──
node_modules/
dist/
.cache/
_stage/

# wrangler 缓存（含账户信息，禁止上传）
.wrangler/

# 日志
*.log
npm-debug.log*

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Obsidian 本地配置（与 .vscode/.idea 同性质：含 workspace 状态与插件二进制，不入库）
# 样式资产的可入库副本在 scripts/obsidian-snippets/，
# 安装时复制到 .obsidian/snippets/ 并在 Appearance 里启用即可。
.obsidian/

# ── 环境变量（敏感信息）──
.env
.env.local
.env.*.local

# 检索工作产物（瞬态，不入库）
中间产物/kb_search_result.json

# BPA v1.0 分片合并产物（可由 head+M01-M07+appendix 用 cat 重建，2026-10-22 巡检）
中间产物/bpa_v1/combined.md

# ── 本地工具产物（Trae / WorkBuddy 生成，仅本机有效，不入库）──
.trae-html-share-packages/
.workbuddy/

# Agent 本地记忆与渲染期临时产物（不入库、不上站）
.workbuddy-ai/
tools/_srpreview/
tools/_shots*/

# WorkBuddy 会话产物（.genie 快照，仅本机可读）
.wbapp_*.genie
