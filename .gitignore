# ── MedAgentWork .gitignore（合并：工具链 + 网页部署，2026-08-20）──

# ── Python / 工具链 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# 原子写入临时文件
*.tmp

# 生成报告（可重建，铁律②：reports/ 按保留策略管理）
reports/

# RAG 索引与分块元数据（可重建）
知识库素材/index_store/
知识库素材/chunks_metadata/

# 本地快捷方式（指向外部路径，仅本机有效）
*.lnk

# 临时目录（铁律：_scratch/temp 一周内清理）
temp/
tmp/

# 历史归档（稳定内容，不入库保持仓库精简）
archive/

# 大体积输入素材（PDF/DOCX 二进制，保持仓库为纯文本）
输入素材/**/*.pdf
输入素材/**/*.docx
知识库素材/**/*.pdf
知识库素材/**/*.docx

# ── 网页部署（Cloudflare Pages / wrangler）──
node_modules/
dist/
.cache/

# wrangler 缓存（含账户信息，禁止上传）
.wrangler/

# 日志
*.log
npm-debug.log*

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── 环境变量（敏感信息）──
.env
.env.local
.env.*.local
