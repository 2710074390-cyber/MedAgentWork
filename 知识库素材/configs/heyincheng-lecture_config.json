{
  "subject": "贺银成讲义",
  "subject_code": "heyincheng-lecture",
  "version": "1.0",
  "description": "考点浓缩型总结，非逐字教材，精炼短小。适用于 heyincheng-jy1/2/3",

  "chunk_strategy": {
    "chunk_size": 500,
    "overlap": 100,
    "min_chunk_size": 60,
    "numeric_threshold": 2,
    "preserve_sequence": false,
    "special_rules": [
      {
        "type": "numeric_protect",
        "min_values": 2
      },
      {
        "type": "pattern_protect",
        "pattern": "(考点|重点|真题|常考|必考)",
        "description": "考点标记不拆分"
      }
    ],
    "metadata_enrichment": ["has_kaodian"]
  },

  "retrieval_strategy": {
    "top_k": 15,
    "top_n": 5,
    "score_threshold": 0.70,
    "hybrid_search": true,
    "keyword_weight": 0.4,
    "chapter_filter": true,
    "rerank_model": "BAAI/bge-reranker-v2-m3"
  },

  "query_enhancement": {
    "synonym_expansion": true,
    "term_map": {}
  }
}
