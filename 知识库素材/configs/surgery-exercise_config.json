{
  "subject": "外科学（习题集）",
  "subject_code": "surgery-exercise",
  "version": "1.0",
  "description": "人卫《外科学学习指导与习题集》第4版 — Q&A格式，每题独立保护",

  "chunk_strategy": {
    "chunk_size": 1200,
    "overlap": 200,
    "min_chunk_size": 150,
    "numeric_threshold": 2,
    "preserve_sequence": true,
    "special_rules": [
      {
        "type": "numeric_protect",
        "min_values": 2,
        "description": "含>=2个数值（如补液量、手术时间窗）的段落不拆分"
      },
      {
        "type": "pattern_protect",
        "pattern": "(A1型题|A2型题|A3型题|A4型题|B1型题|X型题|名词解释|简答题|论述题|病例分析)",
        "description": "题型标题不拆分，整块保留"
      },
      {
        "type": "pattern_protect",
        "pattern": "(题干|问题|选项|答案|解析|★|参考答案|解题思路)",
        "description": "完整Q&A结构不拆分"
      },
      {
        "type": "pattern_protect",
        "pattern": "(TNM|Garden|Neer|AO分型|Mason|Schatzker|Salter-Harris|Weber|Lauge-Hansen)",
        "description": "骨折/肿瘤分期分型不拆分"
      },
      {
        "type": "pattern_protect",
        "pattern": "(适应证|禁忌证|手术时机|手术方式|术式选择|并发症)",
        "description": "手术关键信息不拆分"
      },
      {
        "type": "sequence_protect",
        "description": "手术步骤类题目保持顺序",
        "markers": ["术前", "术中", "术后", "手术步骤", "切口", "显露", "切除", "吻合", "缝合"]
      }
    ],
    "metadata_enrichment": ["has_question", "has_kaodian", "has_procedure", "has_staging", "has_indications", "has_numeric_data"]
  },

  "retrieval_strategy": {
    "top_k": 15,
    "top_n": 5,
    "score_threshold": 0.72,
    "hybrid_search": true,
    "keyword_weight": 0.45,
    "chapter_filter": true,
    "rerank_model": "BAAI/bge-reranker-v2-m3"
  },

  "query_enhancement": {
    "synonym_expansion": true,
    "term_map": {
      "阑尾炎": "急性阑尾炎",
      "胆囊切除": "胆囊切除术",
      "疝修补": "腹股沟疝修补术",
      "甲癌": "甲状腺癌",
      "乳癌": "乳腺癌",
      "胃大切": "胃大部切除术",
      "TURP": "经尿道前列腺电切术"
    }
  }
}
