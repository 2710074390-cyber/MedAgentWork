{
  "subject": "内科学（习题集）",
  "subject_code": "internal-med-exercise",
  "version": "1.0",
  "description": "人卫《内科学学习指导与习题集》第3版 — Q&A格式，每题独立保护",

  "chunk_strategy": {
    "chunk_size": 1200,
    "overlap": 200,
    "min_chunk_size": 150,
    "numeric_threshold": 2,
    "preserve_sequence": false,
    "special_rules": [
      {
        "type": "numeric_protect",
        "min_values": 2,
        "description": "含>=2个数值（如检验值、剂量）的段落不拆分"
      },
      {
        "type": "pattern_protect",
        "pattern": "(A1型题|A2型题|A3型题|A4型题|B1型题|X型题|名词解释|简答题|论述题|病例分析)",
        "description": "题型标题不拆分，整块保留"
      },
      {
        "type": "pattern_protect",
        "pattern": "(题干|问题|选项|答案|解析|★|参考答案|解题思路)",
        "description": "完整Q&A结构不拆分，保留题目+选项+答案+解析"
      },
      {
        "type": "pattern_protect",
        "pattern": "(诊断标准|鉴别诊断|治疗原则|首选药物|禁忌证|适应证|并发症)",
        "description": "诊断治疗关键信息不拆分"
      }
    ],
    "metadata_enrichment": ["has_question", "has_kaodian", "has_diagnostic_criteria", "has_drug_info", "has_numeric_data"]
  },

  "retrieval_strategy": {
    "top_k": 15,
    "top_n": 5,
    "score_threshold": 0.72,
    "hybrid_search": true,
    "keyword_weight": 0.45,
    "chapter_filter": true,
    "rerank_model": "BAAI/bge-reranker-v2-m3"
  },

  "query_enhancement": {
    "synonym_expansion": true,
    "term_map": {
      "房颤": "心房颤动",
      "心梗": "心肌梗死",
      "脑梗": "脑梗死",
      "甲亢": "甲状腺功能亢进症",
      "慢阻肺": "COPD",
      "心衰": "心力衰竭",
      "呼衰": "呼吸衰竭",
      "肾衰": "肾功能衰竭",
      "肝硬化": "肝硬化",
      "首选": "首选药物"
    }
  }
}
