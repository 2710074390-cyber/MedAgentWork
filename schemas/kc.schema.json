{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "medagentwork-kc-registry",
  "title": "MedAgentWork KC Registry",
  "description": "知识组件（KC）注册表契约：卡片、题目、教师重点、教材页码、蓝图模块的唯一映射。",
  "type": "object",
  "required": ["schema_version", "subject", "batch", "generated_at", "cards", "provisional"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "batch": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/definitions/kc" }
    },
    "provisional": {
      "type": "array",
      "items": { "$ref": "#/definitions/kc" }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "kc": {
      "type": "object",
      "required": [
        "kc_id",
        "display_id",
        "subject",
        "module",
        "title",
        "keypoints",
        "status",
        "version"
      ],
      "properties": {
        "kc_id": {
          "type": "string",
          "minLength": 3,
          "description": "规范主键，格式 {subject_code}:{display_id} 或 {subject_code}:SUPP-..."
        },
        "display_id": {
          "type": "string",
          "minLength": 1,
          "description": "文档中可见的 K-ID 或 provisional 显示名"
        },
        "subject": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "pattern": "^M[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "keypoints": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 125 },
          "uniqueItems": true
        },
        "question_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "secondary_question_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "review_anchor": { "type": "string" },
        "content_chars": { "type": "integer", "minimum": 0 },
        "blueprint_weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["active", "content_only", "question_only", "needs_review"]
        },
        "needs_content": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "notes": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
