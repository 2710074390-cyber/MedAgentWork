{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "medagentwork-agent2-output",
  "title": "MedGen 题库产物契约 (agent2_output)",
  "description": "Agent 2 (MedGen) 产出题库 JSON 的结构契约。纯数组；兼容历史字段名（question/question_type/answer_key），required 项为核心契约。由 ingest.py 在摄入时用 jsonschema 校验。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["options"],
    "anyOf": [
      { "required": ["stem"] },
      { "required": ["question"] },
      { "required": ["question_text"] }
    ],
    "properties": {
      "question_id": { "type": "string", "description": "新契约主键，如 NRO-M1-A1-001" },
      "id": { "type": ["string", "integer"], "description": "旧契约主键" },
      "type": { "type": "string", "enum": ["A1", "A2", "A3", "A4", "B1", "X", "判断"] },
      "question_type": { "type": "string", "description": "旧字段名" },
      "polarity": {
        "type": "string",
        "enum": ["positive", "negative", "multi", "正选", "反选", "多选"]
      },
      "bloom_level": {
        "type": "string",
        "enum": ["memory", "comprehension", "application", "analysis", "记忆", "理解", "应用", "分析"]
      },
      "bloom": { "type": "string", "description": "旧字段名" },
      "module": { "type": "string", "description": "模块编号，如 M1" },
      "stem": { "type": "string", "minLength": 1 },
      "question": { "type": "string", "description": "旧字段名" },
      "question_text": { "type": "string", "description": "旧字段名" },
      "options": {
        "type": ["object", "array"],
        "minProperties": 2,
        "description": "新契约: {A: text, B: text, ...}；旧契约: [{label, text}] 或 ['A. text']"
      },
      "answer": { "type": "string", "description": "答案键，如 C" },
      "answer_key": { "type": "string", "description": "新契约答案键" },
      "correct_answer": { "type": "string", "description": "旧字段名" },
      "explanation": { "type": "string", "description": "新契约解析" },
      "analysis": { "type": "string", "description": "旧字段名" },
      "source": { "type": ["string", "array"] },
      "source_pages": { "type": "array", "items": { "type": "string" } },
      "priority_level": { "type": "string", "description": "考点优先级" },
      "difficulty_index": { "type": "number", "description": "预估难度（LLM 估算，非实测）" },
      "discrimination_index": { "type": "number", "description": "预估区分度（LLM 估算，非实测）" },
      "non_functioning_distractors": { "type": "integer" },
      "kaoyan_origin": {
        "type": ["object", "string"],
        "description": "考研原题来源标注（HC-22，2026-08-21；2026-10-22 归入 HC-22）：{gs_id: GS-2024-012, year: 2024, source: '2024考研西综·第12题', mode: '原题'|'改编'}；非考研原题可省略"
      },
      "zhiyi_origin": {
        "type": ["object", "string"],
        "description": "执业医师真题来源标注（HC-22 修订 · 2026-10-22）：{source_id, source, corpus: 'pdf_paper'|'cmexam', mode: '原题'|'改编', answer_confidence: 'high'|'medium'}；corpus=pdf_paper 表示执业医师历年真题（2010–2023 扫描册），cmexam 表示 CMExam 题库补位；非执业医师真题可省略"
      },
      "exam_focus": { "type": ["string", "boolean"] },
      "topic": { "type": "string" },
      "schema_version": {
        "type": "string",
        "enum": ["1.0", "2.0", "2.1"],
        "description": "题目契约版本。2.0 起 learning_value 为交付必需项（HC-24）；2.1 起 concepts 为交付必需项（HC-27，2026-10-27）。1.0/2.0 为历史产物，不追溯。"
      },
      "concepts": {
        "type": "array",
        "description": "HC-27 概念标注（schema 2.1 必填）：这道题测到的概念，1 条 primary + 至少 1 条 differential。keypoint 用教师重点条号（如「第2条」）作为与 KC 卡片的连接键，title 写概念名，evidence 写为什么会测到它。A2/A3/A4/X 至少 2 条；A1/B1/判断 可只写 1 条。",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["role", "keypoint", "title", "evidence"],
          "properties": {
            "role": {
              "type": "string",
              "enum": ["primary", "differential", "related"],
              "description": "primary=本题主概念（每题唯一）；differential=干扰项对应的鉴别概念；related=解析中提到但非干扰项"
            },
            "keypoint": {
              "type": "string",
              "minLength": 2,
              "description": "教师重点条号，与 keypoint_ref 同格式（如「第2条」）。primary 必须与本题 keypoint_ref 一致。"
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "description": "概念名，尽量用教师重点原文的词，便于回查 KC 卡片标题"
            },
            "evidence": {
              "type": "string",
              "minLength": 8,
              "description": "为什么这道题测到这个概念：指出题干/选项/解析中的具体线索，不得只写「相关」"
            }
          },
          "additionalProperties": true
        }
      },
      "learning_value": {
        "type": "object",
        "description": "HC-24 学习价值层。schema_version=2.0 的批次每道题必须提供；详细草案见 schemas/item_v2.draft.schema.json。",
        "required": ["correct_rationale", "per_option", "key_takeaway", "source_quote", "source_quote_status", "anchor_status", "review_status"],
        "properties": {
          "correct_rationale": { "type": "string", "minLength": 60 },
          "per_option": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["label", "truth", "why"],
              "properties": {
                "label": { "type": "string" },
                "truth": { "type": "boolean" },
                "why": { "type": "string", "minLength": 20 },
                "misconception_id": { "type": ["string", "null"], "description": "错误认知类别 ID；同批次同一 ID 必须对应同一释义（R19）" },
                "misconception": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "key_takeaway": { "type": "string", "minLength": 30 },
          "source_quote": { "type": "string", "description": "exact 时必须能在 teacher_anchor 中逐字命中（R16 实证）" },
          "source_quote_status": { "type": "string", "enum": ["exact", "paraphrase", "missing", "mismatch"] },
          "anchor_status": { "type": "string", "enum": ["verified", "partial", "mismatch", "missing"] },
          "quality_flags": { "type": "array", "items": { "type": "string" } },
          "review_status": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "allOf": [
      {
        "if": {
          "required": ["schema_version"],
          "properties": { "schema_version": { "const": "2.1" } }
        },
        "then": { "required": ["concepts"] }
      },
      {
        "if": {
          "required": ["schema_version", "type"],
          "properties": {
            "schema_version": { "const": "2.1" },
            "type": { "enum": ["A2", "A3", "A4", "X"] }
          }
        },
        "then": {
          "properties": { "concepts": { "minItems": 2 } }
        }
      }
    ],
    "additionalProperties": true
  }
}
