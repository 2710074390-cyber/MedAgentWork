{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "medagentwork-agent3-output",
  "title": "MedQC 质检报告契约 (agent3_output)",
  "description": "Agent 3 (MedQC) 质检报告 JSON 的结构契约。核心: report_metadata.gate_decision + dimensions(含 D20) + bloom_distribution。由 ingest.py 在摄入时用 jsonschema 校验。",
  "type": "object",
  "required": ["report_metadata"],
  "properties": {
    "report_metadata": {
      "type": "object",
      "required": ["gate_decision"],
      "properties": {
        "gate_decision": {
          "type": "string",
          "enum": ["PASS", "PASS_WITH_FIXES", "BLOCKED", "APPROVED"]
        },
        "generation_status": {
          "type": "string",
          "enum": ["DONE", "PARTIAL", "FAILED"],
          "description": "生成是否跑完；DONE 不要求所有医学主张已人工核验（HC-28）"
        },
        "release_status": {
          "type": "string",
          "enum": ["READY", "PENDING_HUMAN_REVIEW", "BLOCKED"],
          "description": "发布就绪状态；PENDING_HUMAN_REVIEW 不得反向判定 generation_status=FAILED"
        },
        "publishable_count": { "type": "integer", "minimum": 0 },
        "pending_human_count": { "type": "integer", "minimum": 0 },
        "quarantined_count": { "type": "integer", "minimum": 0 },
        "overall_score": { "type": "number" },
        "batch_id": { "type": "string" },
        "validation_date": { "type": "string" },
        "qc_agent": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dimensions": {
      "type": "array",
      "description": "维度评分列表（v2.0 审查修复: 此前声明为 object，而真实产物（batch027 实测）是数组 [{dimension,status,score,detail}]，ingest 摄入时必然报类型不符）",
      "items": {
        "type": "object",
        "required": ["dimension", "status", "score"],
        "properties": {
          "dimension": { "type": "string", "description": "如 D1_术语规范性 / D20_B1型题专项" },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "MINOR", "MAJOR", "N/A"] },
          "score": { "type": "number" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "dimension_scores": { "type": "object", "description": "旧字段名" },
    "bloom_distribution": {
      "type": "object",
      "description": "记忆/理解/应用/分析 实际占比，Bloom 门禁依据"
    },
    "bloom": { "type": "object", "description": "旧字段名" },
    "overall_score": { "type": "number", "description": "顶层评分（旧格式）" },
    "score": { "type": "number" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "info", "FAIL", "WARN"] },
          "rule": { "type": "string", "description": "检测维度编号，如 D20/D17" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "review_queue": {
      "type": "array",
      "description": "HC-28 人工复核队列：不阻断生成，随产物交付",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "type": "string" },
          "disposition": { "type": "string", "enum": ["pending_human", "quarantined"] },
          "reason_code": {
            "type": "string",
            "enum": ["HUMAN_MEDICAL_REVIEW", "COPYRIGHT", "ORIGINAL_PAPER", "GUIDELINE_CONFLICT", "SOURCE_MISSING"]
          },
          "severity": { "type": "string", "enum": ["blocking_release", "advisory"] },
          "evidence_grade": { "type": "string", "enum": ["A", "B", "C"] },
          "risk_level": { "type": "string", "enum": ["high", "medium", "low"] },
          "agent_checks": { "type": "array", "items": { "type": "string" } },
          "human_check": { "type": "string" },
          "suggested_action": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
